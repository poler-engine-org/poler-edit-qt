[Desktop Entry]
Type=Application
Name=POLER Edit
GenericName=Text Editor
Comment=Sovereign zero-copy, unlimited file-size text editor
Exec=poler-edit %F
Icon=accessories-text-editor
Terminal=false
Categories=Utility;TextEditor;Development;
MimeType=text/plain;text/x-chdr;text/x-csrc;text/x-c++hdr;text/x-c++src;text/x-rust;text/x-python;text/markdown;application/json;
StartupNotify=true
StartupWMClass=poler-edit
